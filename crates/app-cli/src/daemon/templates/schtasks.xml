<?xml version="1.0"?>
<!-- No encoding declaration, and every rendered byte stays ASCII (see
     manifest::xml_escape_ascii): schtasks /Create /XML rejects task
     definitions whose bytes disagree with the declared encoding, and it
     expects ANSI or UTF-16 LE rather than the UTF-8 this file is written as.
     ASCII-only content is byte-identical under all three. -->
<Task version="1.2" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>repo-link reconciliation daemon</Description>
    <URI>\{{LABEL}}</URI>
  </RegistrationInfo>
  <Triggers>
    <LogonTrigger>
      <Enabled>true</Enabled>
      <UserId>{{USER_ID}}</UserId>
      <!-- Task Scheduler has no equivalent of launchd KeepAlive or systemd
           Restart=always: RestartOnFailure below only fires on a non-zero
           exit and is capped. An endless repetition (no Duration) re-requests
           a start every 5 minutes, which MultipleInstancesPolicy=IgnoreNew
           turns into a no-op while the daemon is up and a relaunch once it
           is not, so a clean exit is recovered too within one interval. -->
      <Repetition>
        <Interval>PT5M</Interval>
        <StopAtDurationEnd>false</StopAtDurationEnd>
      </Repetition>
    </LogonTrigger>
  </Triggers>
  <Principals>
    <Principal id="Author">
      <UserId>{{USER_ID}}</UserId>
      <LogonType>InteractiveToken</LogonType>
      <RunLevel>LeastPrivilege</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <AllowHardTerminate>true</AllowHardTerminate>
    <StartWhenAvailable>true</StartWhenAvailable>
    <RunOnlyIfNetworkAvailable>false</RunOnlyIfNetworkAvailable>
    <IdleSettings>
      <StopOnIdleEnd>false</StopOnIdleEnd>
      <RestartOnIdle>false</RestartOnIdle>
    </IdleSettings>
    <AllowStartOnDemand>true</AllowStartOnDemand>
    <Enabled>true</Enabled>
    <Hidden>false</Hidden>
    <RunOnlyIfIdle>false</RunOnlyIfIdle>
    <WakeToRun>false</WakeToRun>
    <!-- PT0S disables the 72h default kill that schtasks-created tasks
         inherit; a reconciliation daemon is meant to outlive it. -->
    <ExecutionTimeLimit>PT0S</ExecutionTimeLimit>
    <Priority>7</Priority>
    <RestartOnFailure>
      <Interval>PT1M</Interval>
      <Count>3</Count>
    </RestartOnFailure>
  </Settings>
  <Actions Context="Author">
    <Exec>
      <!-- No cmd.exe wrapper: Task Scheduler hands Command and Arguments to
           CreateProcess verbatim, so a path holding a space, a percent sign
           or an ampersand stays literal. The trade is that Task Scheduler
           discards stdout/stderr, so there is no pre-tracing panic catcher
           here; `--log-format=json` makes rld write its own rotated file,
           the same arrangement as under systemd. -->
      <Command>{{BINARY_PATH}}</Command>
      <Arguments>--log-format=json</Arguments>
    </Exec>
  </Actions>
</Task>
